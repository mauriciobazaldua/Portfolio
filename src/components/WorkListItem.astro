---
// One row in the homepage's "Selected work" list — numbered, text-left,
// image-right. Falls back to a gradient placeholder for case studies that
// don't have a real screenshot authored yet — see PROJECT-CONTEXT.md's
// known content gap; `image` is optional for exactly that reason.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { formatInline } from "../utils/formatInline";

interface Props {
  index: number;
  slug: string;
  title: string;
  oneLiner: string;
  company?: string;
  role: string;
  timeline: string;
  image?: { src: ImageMetadata; alt: string };
}

const { index, slug, title, oneLiner, company, role, timeline, image } = Astro.props;
const number = String(index).padStart(2, "0");
// Placeholder content (role/timeline not authored yet) shouldn't go through
// the caption's uppercase transform — "e.g." becomes "E.G." next to
// real-looking dates and reads as corrupted data rather than an obvious TODO.
const isPlaceholder = role.includes("TODO") || timeline.includes("TODO");
const captionParts = [company, role, timeline].filter(Boolean);
---

<a class="work-item" href={`/work/${slug}`} aria-label={title}>
  <span class="work-item__index" aria-hidden="true">{number}</span>
  <div class="work-item__text">
    <h3 class="work-item__title">{title}</h3>
    <p class="work-item__one-liner" set:html={formatInline(oneLiner)} />
    <p class:list={["work-item__caption", { "work-item__caption--placeholder": isPlaceholder }]}>
      {captionParts.join(" · ")}
    </p>
  </div>
  {image ? (
    <Image
      src={image.src}
      alt=""
      widths={[288, 576]}
      sizes="240px"
      class="work-item__image work-item__image--real"
    />
  ) : (
    <div class="work-item__image" aria-hidden="true"></div>
  )}
</a>

<style>
  .work-item {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-6);
    padding: var(--space-7) 0;
    border-top: 1px solid var(--home-border);
    text-decoration: none;
    color: var(--home-fg);
    transition: background-color 0.3s var(--ease-out-expo);
  }

  .work-item:first-child {
    border-top: none;
  }

  .work-item__index {
    font-family: var(--font-display);
    font-size: var(--text-numeral);
    font-weight: 400;
    font-variant-numeric: tabular-nums;
    color: var(--home-fg-muted);
    opacity: 0.5;
    transition: opacity 0.3s var(--ease-out-expo), color 0.3s var(--ease-out-expo);
  }

  .work-item__title {
    font-family: var(--font-display);
    font-size: var(--text-title);
    font-weight: 500;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    margin: 0 0 var(--space-2);
    transition: color 0.3s var(--ease-out-expo);
  }

  .work-item__one-liner {
    color: var(--home-fg-muted);
    max-width: 42ch;
    margin: 0 0 var(--space-3);
  }

  .work-item__caption {
    font-family: var(--font-display);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--home-fg-tertiary);
    margin: 0;
  }

  .work-item__caption--placeholder {
    text-transform: none;
    letter-spacing: normal;
  }

  .work-item__image {
    width: 15rem;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-md);
    background: var(--home-bg);
    border: 1px solid var(--home-border);
    transition: transform 0.4s var(--ease-out-expo);
  }

  .work-item__image--real {
    height: auto;
    object-fit: cover;
  }

  .work-item:hover .work-item__index,
  .work-item:focus-visible .work-item__index {
    opacity: 1;
    color: var(--home-accent);
  }

  .work-item:hover .work-item__title,
  .work-item:focus-visible .work-item__title {
    color: var(--home-accent);
  }

  .work-item:hover .work-item__image,
  .work-item:focus-visible .work-item__image {
    transform: scale(1.03);
  }

  .work-item:focus-visible {
    outline: 2px solid var(--home-accent);
    outline-offset: 6px;
  }

  @media (max-width: 640px) {
    .work-item {
      grid-template-columns: auto 1fr;
      gap: var(--space-4);
    }

    .work-item__image {
      display: none;
    }
  }
</style>
