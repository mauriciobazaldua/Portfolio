---
// Contact lives here, not on a dedicated /contact page — see PORTFOLIO-IA.md
// ("Why still no /contact page"). Destinations come from src/lib/site.ts.
// This footer only renders on non-Home pages, same as Header.astro.
import { contact } from "../lib/site";
---

<footer class="site-footer">
  <a href={`mailto:${contact.email}`}>Email</a>
  <a href={contact.linkedin} target="_blank" rel="noopener">LinkedIn</a>
</footer>

<style>
  .site-footer {
    display: flex;
    gap: var(--space-4);
    max-width: var(--container-max-full);
    margin-inline: auto;
    padding: var(--space-6) var(--container-padding);
    border-top: 1px solid var(--color-border);
    color: var(--color-fg-muted);
  }

  .site-footer a {
    text-decoration: none;
    color: inherit;
  }

  .site-footer a:hover {
    color: var(--color-accent);
  }
</style>
